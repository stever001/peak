# Next.js server-side settings (never exposed to browser JavaScript). Copy to .env.local.
# Python API (FastAPI) base URL, reached only from the Next.js server.
PEAK_API_BASE_URL=http://127.0.0.1:8000
# Local plain-HTTP development only (e.g. testing an iPad over the LAN): drop the Secure cookie flag.
# PEAK_WEB_INSECURE_COOKIE=1
