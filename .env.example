# Example environment for the Peak controlled engagement database (MySQL).
# Copy to `.env` and fill in real values. `.env` is gitignored and must NEVER be
# committed. This file contains PLACEHOLDERS ONLY — no real credentials.

# Three roles, three variables, three credentials — deliberately NOT interchangeable (Phase 49).
# Never set more than one of these from the same env file, and never point two of them at the
# same database user: the separation is what keeps runtime from holding schema privileges.

# 1. Alembic / migration / bootstrap only (alembic/env.py). Schema-changing credential.
PEAK_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/peak_dev

# 2. Application / runtime DB sessions only (peak/db/session.py). Least-privilege credential —
#    SELECT + INSERT is all the create-only controlled writers require (Phase 48). Runtime never
#    falls back to PEAK_DATABASE_URL; if this is unset, runtime fails closed.
PEAK_RUNTIME_DATABASE_URL=mysql+pymysql://runtime_user:password@localhost:3306/peak_dev

# 3. Read-only production verifier only (tools/production_mysql_collation_verify.py). Read-only
#    credential; it is gated behind PEAK_PRODUCTION_DB_READONLY_CONFIRM=1 and must never be
#    upgraded to write.
# PEAK_PRODUCTION_DB_URL=mysql+pymysql://readonly_user:password@localhost:3306/peak_dev
# PEAK_PRODUCTION_DB_READONLY_CONFIRM=1
